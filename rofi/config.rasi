configuration {
    modi: "drun,run";
    show-icons: false;
    display-drun: "";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font Medium 11";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: [ MousePrimary ];
}

@theme "~/.config/rofi/themes/gruvbox-flat.rasi"
